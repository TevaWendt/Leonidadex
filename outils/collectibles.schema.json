{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalogue des collectibles Leonidakit",
  "description": "Les champs optionnels absents sont normalisés à null, [] ou false par gen-collectibles.cjs. La CLI vérifie aussi les identifiants uniques, références, dates réelles et fichiers locaux.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAt",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "categories": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?!constructor$|prototype$)[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url",
        "kind",
        "checkedAt"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "url": {
          "$ref": "#/$defs/sourceUrl"
        },
        "kind": {
          "enum": [
            "official",
            "community",
            "press"
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt",
        "width",
        "height",
        "credit",
        "sourceUrl"
      ],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^/?(?:img|photos)/[a-zA-Z0-9_./,-]+\\.(?:webp|png|jpe?g|avif)$",
          "maxLength": 500
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "credit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sourceUrl": {
          "$ref": "#/$defs/sourceUrl"
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "x",
        "y",
        "verified",
        "sourceUrl"
      ],
      "properties": {
        "system": {
          "const": "leonidakit-v1"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 5200
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 6000
        },
        "verified": {
          "const": true
        },
        "sourceUrl": {
          "$ref": "#/$defs/sourceUrl"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!constructor$|prototype$)[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 100
        },
        "slug": {
          "type": "string",
          "pattern": "^(?!constructor$|prototype$)[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!constructor$|prototype$)[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "established",
            "unconfirmed",
            "placeholder"
          ]
        },
        "subcategory": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "zone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "place": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "difficulty": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "reward": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "gallery": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/coordinates"
            },
            {
              "type": "null"
            }
          ]
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "requirements": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "tips": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "hints": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "notes": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "keywords": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "relatedIds": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "pattern": "^(?!constructor$|prototype$)[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 100
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "verifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indexable": {
              "type": "boolean",
              "default": false
            },
            "description": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 320
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "published": {
          "type": "boolean",
          "default": false
        },
        "trackable": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
