{
 "schemaVersion": 2,
 "definitions": [
  {
   "id": "recette",
   "title": "Récompense",
   "terms": [
    "recette",
    "revenu brut",
    "chiffre d’affaires"
   ],
   "text": "C’est l’argent que tu reçois à la fin d’une mission, avant de payer tes frais. Ce n’est pas ce qu’il te reste vraiment."
  },
  {
   "id": "benefice-net",
   "title": "Gain, ou bénéfice",
   "terms": [
    "benefice net",
    "gain net",
    "profit net",
    "gain",
    "benefice",
    "ce qu il me reste"
   ],
   "text": "C’est ce qu’il te reste une fois tes frais payés. Récompense 100 000 $, frais 20 000 $ : ton gain est de 80 000 $."
  },
  {
   "id": "roi",
   "title": "ROI : ce que rapporte un achat en %",
   "terms": [
    "roi",
    "retour sur investissement"
   ],
   "text": "C’est ce qu’un achat t’a fait gagner, en pourcentage de son prix : gagné au final ÷ prix × 100. 0 % veut dire remboursé ; 100 % veut dire qu’il a rapporté deux fois son prix."
  },
  {
   "id": "amortissement",
   "title": "Amortissement, ou « remboursé »",
   "terms": [
    "amortissement",
    "amortir",
    "seuil de rentabilite",
    "rembourse",
    "remboursement",
    "rembourser",
    "remboursee"
   ],
   "text": "C’est le moment où un achat t’a rapporté autant qu’il t’a coûté. Dans « Ça vaut le coup ? », le calculateur te dit après combien d’heures de jeu tu y arrives."
  },
  {
   "id": "rendement",
   "title": "Rendement",
   "terms": [
    "rendement",
    "taux de rendement"
   ],
   "text": "C’est ce que rapporte une somme dépensée, sur une durée donnée. Un chiffre par heure de jeu n’est pas un rendement : il faut dire combien de temps tu t’en sers."
  },
  {
   "id": "reserve",
   "title": "Argent gardé de côté (réserve)",
   "terms": [
    "reserve",
    "capital disponible",
    "argent de cote",
    "garde de cote",
    "mis de cote"
   ],
   "text": "C’est la part de ton argent que tu ne veux pas dépenser. Le calculateur n’y touche jamais : il fait comme si cet argent n’existait pas pour tes achats."
  }
 ],
