{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/vehicules/airgator-airboat-09.html",
      "destination": "/vehicules/airboat-09.html",
      "permanent": true
    },
    {
      "source": "/vehicules/vehicules.html",
      "destination": "/vehicules.html",
      "permanent": true
    },
    {
      "source": "/armes/pistolet-jason.html",
      "destination": "/armes/girardi-es9.html",
      "permanent": true
    },
    {
      "source": "/armes/pistolet-tactique.html",
      "destination": "/armes/klose-k17.html",
      "permanent": true
    },
    {
      "source": "/armes/pistolet-compact.html",
      "destination": "/armes/nipper-38.html",
      "permanent": true
    },
    {
      "source": "/armes/revolver-357.html",
      "destination": "/armes/mustang-357.html",
      "permanent": true
    },
    {
      "source": "/armes/armes/:path*",
      "destination": "/armes/:path*",
      "permanent": true
    },
    {
      "source": "/personnages/personnages/:path*",
      "destination": "/personnages/:path*",
      "permanent": true
    },
    {
      "source": "/photos/photos/:path*",
      "destination": "/photos/:path*",
      "permanent": true
    },
    {
      "source": "/img/officiel/officiel/:path*",
      "destination": "/img/officiel/:path*",
      "permanent": true
    },
    {
      "source": "/munitions.html",
      "destination": "/armes.html#munitions",
      "permanent": true
    },
    {
      "source": "/vetements.html",
      "destination": "/style.html#tenues",
      "permanent": true
    },
    {
      "source": "/accessoires.html",
      "destination": "/style.html#accessoires",
      "permanent": true
    },
    {
      "source": "/tatouages.html",
      "destination": "/style.html#tatouages",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/munitions.html",
      "destination": "/:lang/armes.html#munitions",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/vetements.html",
      "destination": "/:lang/style.html#tenues",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/accessoires.html",
      "destination": "/:lang/style.html#accessoires",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/tatouages.html",
      "destination": "/:lang/style.html#tatouages",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/index.html",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/vehicules/vehicules.html",
      "destination": "/:lang/vehicules.html",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/vehicules/airgator-airboat-09.html",
      "destination": "/:lang/vehicules/airboat-09.html",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/armes/pistolet-jason.html",
      "destination": "/:lang/armes/girardi-es9.html",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/armes/pistolet-tactique.html",
      "destination": "/:lang/armes/klose-k17.html",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/armes/pistolet-compact.html",
      "destination": "/:lang/armes/nipper-38.html",
      "permanent": true
    },
    {
      "source": "/:lang(en|es|it|de)/armes/revolver-357.html",
      "destination": "/:lang/armes/mustang-357.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://open.spotify.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://affd58b3.sibforms.com"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/leo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/atelier/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/((?!api/).*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/leo-index.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
